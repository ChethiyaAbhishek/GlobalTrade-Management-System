<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="GlobalTrade-PU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>jdbc/_GlobalTrade</jta-data-source>

        <class>com.globaltrade.core.entity.Shipment</class>
        <class>com.globaltrade.core.entity.ShipmentTrackingEvent</class>
        <class>com.globaltrade.core.entity.InventoryItem</class>
        <class>com.globaltrade.core.entity.Warehouse</class>
        <class>com.globaltrade.core.entity.Vendor</class>
        <class>com.globaltrade.core.entity.VendorPerformance</class>
        <class>com.globaltrade.core.entity.CustomsDocument</class>
        <class>com.globaltrade.core.entity.Order</class>
        <class>com.globaltrade.core.entity.OrderItem</class>
        <class>com.globaltrade.core.entity.AuditLog</class>
        <class>com.globaltrade.core.entity.Alert</class>
        <class>com.globaltrade.core.entity.User</class>
        <class>com.globaltrade.core.entity.Role</class>
        <class>com.globaltrade.core.entity.PurchaseRequest</class>
        <class>com.globaltrade.core.entity.InventoryMovement</class>

        <properties>
            <property name="hibernate.enhancer.enableLazyInitialization" value="false"/>
            <property name="hibernate.enhancer.enableDirtyTracking" value="false"/>
            <property name="hibernate.enhancer.enableAssociationManagement" value="false"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.transaction.jta.platform"
                      value="org.hibernate.engine.transaction.jta.platform.internal.SunOneJtaPlatform"/>
        </properties>
    </persistence-unit>
</persistence>