<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.globaltrade</groupId>
    <artifactId>globaltrade-management-system</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>
    <modules>
        <module>globaltrade-core</module>
        <module>globaltrade-interceptors</module>
        <module>globaltrade-security</module>
        <module>globaltrade-messaging-ejb</module>
        <module>globaltrade-shipment-ejb</module>
        <module>globaltrade-inventory-ejb</module>
        <module>globaltrade-vendor-ejb</module>
        <module>globaltrade-web</module>
        <module>globaltrade-ear</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.api.version>10.0.0</jakartaee.api.version>
        <jakartaee.web.api.version>10.0.0</jakartaee.web.api.version>
        <log4j.core.version>2.25.4</log4j.core.version>
        <mysql.connector.version>8.0.33</mysql.connector.version>
        <hibernate.core.version>6.5.3.Final</hibernate.core.version>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-core</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-interceptors</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-security</artifactId>
                <version>${project.version}</version>
                <type>jar</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-messaging-ejb</artifactId>
                <version>${project.version}</version>
                <type>ejb</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-shipment-ejb</artifactId>
                <version>${project.version}</version>
                <type>ejb</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-inventory-ejb</artifactId>
                <version>${project.version}</version>
                <type>ejb</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-vendor-ejb</artifactId>
                <version>${project.version}</version>
                <type>ejb</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-web</artifactId>
                <version>${project.version}</version>
                <type>war</type>
            </dependency>

            <dependency>
                <groupId>com.globaltrade</groupId>
                <artifactId>globaltrade-ear</artifactId>
                <version>${project.version}</version>
                <type>ear</type>
            </dependency>

            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee.api.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-web-api</artifactId>
                <version>${jakartaee.web.api.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.core.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.connector.version}</version>
            </dependency>

            <dependency>
                <groupId>org.hibernate</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.core.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>